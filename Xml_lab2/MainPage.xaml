<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Xml_lab2.Models"
             xmlns:vm="clr-namespace:Xml_lab2.ViewModels"
             x:Class="Xml_lab2.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Спорт на факультеті">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="15" RowSpacing="10">

        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Відкрити XML" Clicked="OpenXml_Clicked" />
            <Button Text="Відкрити XSL" Clicked="OpenXsl_Clicked" />
            <Label Text="{Binding FilesInfo}" VerticalOptions="Center" Margin="10,0,0,0" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Picker Title="Аналізатор" WidthRequest="160" ItemsSource="{Binding Analyzers}" SelectedItem="{Binding SelectedAnalyzer}" />
            <Picker Title="Атрибут" WidthRequest="180" ItemsSource="{Binding AttributeNames}" SelectedItem="{Binding SelectedAttribute}" />
            <Picker Title="Значення" WidthRequest="200" ItemsSource="{Binding AttributeValues}" SelectedItem="{Binding SelectedAttributeValue}" />
            <Entry Placeholder="Ключове слово" WidthRequest="230" Text="{Binding SearchKeyword}" />
            <Button Text="Пошук" Clicked="Search_Clicked" />
            <Button Text="Clear" Clicked="Clear_Clicked" />
        </HorizontalStackLayout>

        <Label Grid.Row="2" Text="{Binding StatusText}" FontAttributes="Italic" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding SportsRecords}">
            <CollectionView.EmptyView>
                <Label Text="Немає результатів" HorizontalOptions="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SportRecord">
                    <Border Padding="10" Margin="0,4" Stroke="LightGray">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding StudentName}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Faculty, StringFormat='Факультет: {0}'}" />
                            <Label Text="{Binding SportSection, StringFormat='Секція: {0}'}" />
                            <Label Text="{Binding Schedule, StringFormat='Графік: {0}'}" />
                            <Label Text="{Binding Details}" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="4" Spacing="8">
            <Button Text="Трансформувати в HTML" Clicked="Transform_Clicked" />
            <Button Text="Зберегти XML" Clicked="SaveXml_Clicked" />
            <Button Text="Вийти" Clicked="Exit_Clicked" BackgroundColor="IndianRed" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
